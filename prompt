        - `Find-LastValidOffset.sh`
            
            ```bash
            #!/usr/bin/env bash
            set -euo pipefail
            
            # Usage:
            # Find-LastValidOffset.sh --InstanceId xxx --RepoId xxx --BuildRecordId xxx [--Region cn-shanghai] [--PageSize 100] [--StartOffset 0]
            
            InstanceId=""
            RepoId=""
            BuildRecordId=""
            Region="cn-shanghai"
            PageSize=100
            StartOffset=0
            
            # Parse arguments
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --InstanceId)
                        InstanceId="$2"
                        shift 2
                        ;;
                    --RepoId)
                        RepoId="$2"
                        shift 2
                        ;;
                    --BuildRecordId)
                        BuildRecordId="$2"
                        shift 2
                        ;;
                    --Region)
                        Region="$2"
                        shift 2
                        ;;
                    --PageSize)
                        PageSize="$2"
                        shift 2
                        ;;
                    --StartOffset)
                        StartOffset="$2"
                        shift 2
                        ;;
                    *)
                        echo "Unknown argument: $1" >&2
                        exit 1
                        ;;
                esac
            done
            
            # Check mandatory params
            if [[ -z "$InstanceId" || -z "$RepoId" || -z "$BuildRecordId" ]]; then
                cat >&2 <<EOF
            Missing mandatory parameters!
            Required: --InstanceId --RepoId --BuildRecordId
            Optional: --Region --PageSize --StartOffset
            EOF
                exit 1
            fi
            
            currentOffset="$StartOffset"
            lastValidOffset=""
            totalLines=0
            
            while true; do
                echo -e "\033[36m>>> Query offset = $currentOffset\033[0m"
            
                # Call aliyun cli, get json, extract TotalCount with jq
                cliResult=$(aliyun cr list-repo-build-record-log \
                    --instance-id "$InstanceId" \
                    --repo-id "$RepoId" \
                    --build-record-id "$BuildRecordId" \
                    --offset "$currentOffset" \
                    --region "$Region")
            
                pageCount=$(echo "$cliResult" | jq -r '.TotalCount')
                echo "    Records on this page: $pageCount"
            
                if [[ "$pageCount" -le 0 ]]; then
                    echo -e "\n\033[33m[STOP] Empty page received.\033[0m"
                    break
                fi
            
                lastValidOffset="$currentOffset"
                totalLines=$(( totalLines + pageCount ))
                currentOffset=$(( currentOffset + PageSize ))
            done
            
            echo -e "\n\033[32m=== Result ===\033[0m"
            if [[ -n "$lastValidOffset" ]]; then
                echo "Last valid offset (n): $lastValidOffset"
                echo "Total log lines: $totalLines"
            else
                echo "No log records found."
                echo "Total log lines: 0"
            fi
            
            ```
            
    - `RunCommandUntilOutput.sh`
        - prompt
            
            现有`aliyun cr get-artifact-subscription-task --instance-id ... --task-id ... --region ...`命令，执行结果可能为：
            
            1. 输出内容中某行有"TaskStatus": "COMPLETED"，且另外一行有"TaskResult"
            2. 输出内容中某行有"TaskStatus": "yyy"（yyy不是COMPLETED），且输出内容中不存在"TaskResult"
            
            现在给出一个shell脚本，用于反复执行上述命令并轮询，直到出现特定的输出内容（情况1），然后返回这次执行命令的完整结果
            
            要求脚本用法为`RunCommandUntilOutput.ps1 --pre-command … --pre-script ... --repeat-command … --condition ... --repeat-script ... --post-command … --post-script ... --poll-interval … --max-time …`，从而可以被后续迁移到其他的命令。
            
            其中repeat-command和repeat-script是需要被反复执行的命令，condition是判停的条件，pre-command和pre-script是在执行repeat-command之前要执行的操作，post-command和post-script是在执行repeat-comand之后要执行的操作，poll-interval是轮询的时间间隔，max-time是整个脚本的最大执行时长
            
        - `RunCommandUntilOutput.sh`
            
            ```bash
            #!/usr/bin/env bash
            set -uo pipefail
            
            # 解析 --key value 参数
            declare -A parsed=()
            raw_args=("$@")
            i=0
            while [[ $i -lt ${#raw_args[@]} ]]; do
                arg="${raw_args[$i]}"
                if [[ "$arg" =~ ^--(.+)$ ]]; then
                    key="${BASH_REMATCH[1]}"
                    ((i++))
                    if [[ $i -lt ${#raw_args[@]} ]]; then
                        parsed["$key"]="${raw_args[$i]}"
                    else
                        parsed["$key"]=""
                    fi
                fi
                ((i++))
            done
            
            # 提取参数
            pre_command="${parsed[pre-command]-}"
            pre_script="${parsed[pre-script]-}"
            repeat_command="${parsed[repeat-command]-}"
            repeat_script="${parsed[repeat-script]-}"
            condition_code="${parsed[condition]-}"
            post_command="${parsed[post-command]-}"
            post_script="${parsed[post-script]-}"
            poll_interval="${parsed[poll-interval]:-2.0}"
            max_time="${parsed[max-time]:-300.0}"
            
            # 必填校验
            if [[ -z "$condition_code" ]]; then
                echo "ERROR: 必须指定 --condition" >&2
                exit 1
            fi
            if [[ -z "$repeat_command" && -z "$repeat_script" ]]; then
                echo "ERROR: 必须指定 --repeat-command 或者 --repeat-script" >&2
                exit 1
            fi
            
            start_at=$(date +%s.%N)
            lastOutput=""
            
            # 前置逻辑，只执行一次
            if [[ -n "$pre_script" ]]; then
                echo "VERBOSE: 执行 pre-script" >&2
                eval -- "$pre_script"
            fi
            if [[ -n "$pre_command" ]]; then
                echo "VERBOSE: 执行 pre-command: $pre_command" >&2
                eval -- "$pre_command" >/dev/null
            fi
            
            while true; do
                # 执行轮询主体，捕获 stdout+stderr
                if [[ -n "$repeat_script" ]]; then
                    echo "VERBOSE: 执行 repeat-script" >&2
                    lastOutput=$(eval -- "$repeat_script" 2>&1)
                else
                    echo "VERBOSE: 执行 repeat-command: $repeat_command" >&2
                    lastOutput=$(eval -- "$repeat_command" 2>&1)
                fi
            
                # condition 单独捕获返回码，不受 set -e 影响
                set +e
                eval -- "$condition_code"
                cond_rc=$?
                set -u
            
                if [[ $cond_rc -eq 0 ]]; then
                    echo "VERBOSE: 条件满足，准备执行后置逻辑" >&2
                    if [[ -n "$post_script" ]]; then
                        eval -- "$post_script"
                    fi
                    if [[ -n "$post_command" ]]; then
                        eval -- "$post_command" >/dev/null
                    fi
                    echo "$lastOutput"
                    exit 0
                fi
            
                # 超时判断
                now=$(date +%s.%N)
                elapsed=$(echo "$now - $start_at" | bc -l)
                if (( $(echo "$elapsed >= $max_time" | bc -l) )); then
                    echo "ERROR: 轮询超时（max-time=$max_time s），已退出。最后一次输出：" >&2
                    echo "$lastOutput" >&2
                    exit 2
                fi
            
                sleep "$poll_interval"
            done
            
            ```
            
